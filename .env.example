# Postgres connection (Supabase/Neon). If omitted, the app uses an embedded
# PGlite database in ./.pglite (great for local dev; not for Vercel).
DATABASE_URL=

# AiZcy proxy (OpenAI-compatible) for receipt vision. Server-side only.
AI_API_KEY=
AI_BASE_URL=https://a.izcy.tech/v1
AI_MODEL=DeepSeek V4 Flash

# Passcode to open the app, and a long random string to sign session cookies.
APP_PASSCODE=
AUTH_SECRET=

# Upstash Redis (rate limiting login). Optional — falls back to in-memory.
# Vercel: add the "Upstash for Redis" integration to inject these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Harga jastip untuk pencarian publik: markup % (kurs live via open.er-api.com).
JASTIP_MARKUP=10

# Web push notification (VAPID). Generate: web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
